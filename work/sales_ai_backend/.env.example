# Sales AI backend local environment example.
# Copy to .env for local development. Do not commit real .env files.

APP_NAME=Sales AI Backend

# Local development can keep SQLite.
DATABASE_URL=sqlite:///./sales_ai.db

# Production example:
# DATABASE_URL=mysql+pymysql://sales_ai:your-password@mysql:3306/sales_ai?charset=utf8mb4
# DATABASE_URL=postgresql+psycopg2://sales_ai:your-password@postgres:5432/sales_ai

JWT_SECRET_KEY=change-this-local-dev-secret
JWT_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_OCR_MODEL=qwen-vl-plus
DASHSCOPE_ASR_MODEL=paraformer-v2

ASR_AUDIO_BASE_URL=
ASR_PROVIDER=
ASR_API_KEY=

# Telephony provider. Keep mock until a real provider is selected.
CALL_PROVIDER=mock
CALL_PROVIDER_BASE_URL=
CALL_PROVIDER_APP_ID=
CALL_PROVIDER_APP_KEY=
CALL_PROVIDER_APP_SECRET=
CALL_PROVIDER_CALLER=
CALL_PROVIDER_SCRIPT_ID=
CALL_PROVIDER_WEBHOOK_SECRET=
CALL_PROVIDER_CONFIG_SECRET=
CALL_PROVIDER_TIMEOUT=30
AI_ROBOT_AUTO_SYNC_ENABLED=true
AI_ROBOT_AUTO_SYNC_INTERVAL_SECONDS=15
AI_ROBOT_AUTO_SYNC_BATCH_SIZE=20

# External website and terminal integration API.
# Set a long random value and send it as X-Integration-Key.
INTEGRATION_API_KEY=
INTEGRATION_TENANT_ID=1

# Wotao Core service identity for AI calling. Use a different long random token
# from employee JWTs and from INTEGRATION_API_KEY.
PLATFORM_SERVICE_TOKEN=
PLATFORM_TENANT_ID=1

# File storage. Keep local for development. Use oss in production when Alibaba Cloud OSS is configured.
STORAGE_BACKEND=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=sales-ai
OSS_PUBLIC_BASE_URL=
OSS_SIGNED_URL_EXPIRES=600
