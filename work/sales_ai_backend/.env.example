# ============================================
# 销售AI线索雷达 - 环境配置示例
# 复制为 .env 后按需修改
# ============================================

# --- AI 服务配置 ---
# DeepSeek API Key（用于文本意向分析）
DEEPSEEK_API_KEY=
# DeepSeek 基础地址（默认官方）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 模型名
# DEEPSEEK_MODEL=deepseek-v4-flash

# 阿里云 DashScope API Key（用于图片OCR识别）
DASHSCOPE_API_KEY=
# DashScope 基础地址
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 安全配置 ---
# JWT 签名密钥（留空自动生成随机密钥）
# JWT_SECRET_KEY=
# 管理员初始密码（留空自动生成随机密码）
# DEFAULT_ADMIN_PASSWORD=
# Token 过期时间（分钟，默认1440即24小时）
# JWT_EXPIRE_MINUTES=1440

# --- CORS 配置 ---
# 允许跨域访问的来源（多个用逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- 数据库 ---
# 默认 SQLite，生产环境建议用 PostgreSQL
# DATABASE_URL=sqlite:///./sales_ai.db
