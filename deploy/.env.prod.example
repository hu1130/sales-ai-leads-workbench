# Sales AI production environment example.
# Copy this file to deploy/.env.prod and change every password/key before going online.

APP_NAME=Sales AI Backend

# MySQL container settings. Keep MYSQL_PASSWORD and DATABASE_URL password consistent.
MYSQL_DATABASE=sales_ai
MYSQL_USER=sales_ai
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Default production database: MySQL.
DATABASE_URL=mysql+pymysql://sales_ai:change-this-mysql-password@mysql:3306/sales_ai?charset=utf8mb4

# PostgreSQL is also supported if you switch the database service yourself:
# DATABASE_URL=postgresql+psycopg2://sales_ai:your-password@postgres:5432/sales_ai

JWT_SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=1440
UPLOAD_DIR=/app/uploads
CORS_ORIGINS=*
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-admin-password

# The server already has another service on 80/443, so use 8081 by default.
# After testing, you can put this service behind your main Nginx/domain.
WEB_PORT=8081

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_OCR_MODEL=qwen-vl-plus
DASHSCOPE_ASR_MODEL=paraformer-v2
ASR_AUDIO_BASE_URL=

# Optional ASR settings. Keep empty to use DashScope-compatible ASR above.
ASR_PROVIDER=
ASR_API_KEY=
ASR_POLL_TIMEOUT=300
ASR_POLL_INTERVAL=2
PUBLIC_FILE_TOKEN=

# Call provider settings.
# Keep CALL_PROVIDER=mock for cloud smoke tests before buying/configuring a real telephony provider.
CALL_PROVIDER=mock
CALL_PROVIDER_BASE_URL=
CALL_PROVIDER_APP_ID=
CALL_PROVIDER_APP_KEY=
CALL_PROVIDER_APP_SECRET=
CALL_PROVIDER_CALLER=
CALL_PROVIDER_WEBHOOK_SECRET=
# Used to encrypt telephony secrets saved from the admin settings page.
# Change this to a long random value before production.
CALL_PROVIDER_CONFIG_SECRET=change-this-call-provider-config-secret
CALL_PROVIDER_TIMEOUT=30
AI_ROBOT_AUTO_SYNC_ENABLED=true
AI_ROBOT_AUTO_SYNC_INTERVAL_SECONDS=15
AI_ROBOT_AUTO_SYNC_BATCH_SIZE=20

# External website and terminal integration API.
# Set a long random value and send it as X-Integration-Key.
INTEGRATION_API_KEY=change-this-integration-api-key
INTEGRATION_TENANT_ID=1

# Wotao Core AI-calling service identity. Rotate independently from employee JWTs.
PLATFORM_SERVICE_TOKEN=change-this-platform-service-token
PLATFORM_TENANT_ID=1

# File storage. Keep local if you want files on the server disk.
# Set STORAGE_BACKEND=oss after Alibaba Cloud OSS is ready.
STORAGE_BACKEND=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=sales-ai
OSS_PUBLIC_BASE_URL=
OSS_SIGNED_URL_EXPIRES=600
